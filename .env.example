# Database (PostgreSQL). Create the databases first, e.g. in Postgres.app: CREATE DATABASE stocksee; CREATE DATABASE stocksee_test;
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stocksee?schema=public"
# Used only by `npm test` (tables are wiped between tests — never point this at real data)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stocksee_test?schema=public"

# Signs the anonymous visitor cookie. Long random string, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Frontend origin(s) allowed to call the API with cookies (comma-separated)
CORS_ORIGINS="http://localhost:5173"
PORT=3000

# Telegram: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=""

# AI providers (optional; without them a built-in template engine answers)
GEMINI_API_KEY=""
GROQ_API_KEY=""
# Optional model overrides (change these if a provider retires a model)
GEMINI_MODEL="gemini-2.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"

# Redis (optional; caches the daily market narrative)
REDIS_URL="redis://localhost:6379"

# Sentry (optional)
SENTRY_DSN=""
