{
  "name": "stocksee",
  "version": "1.0.0",
  "description": "StockSee \u2014 Vernacular Market Intelligence & Watchlist Platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "job": "node scripts/run-job.js",
    "symbols:update": "node scripts/update-symbols.js",
    "surveillance:import": "node scripts/import-surveillance.js",
    "advisers:import": "node scripts/import-advisers.js",
    "lint": "eslint src scripts tests"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "@sentry/node": "^7.100.1",
    "axios": "^1.6.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "prisma": "^5.12.1",
    "redis": "^4.6.13",
    "telegraf": "^4.12.2",
    "yahoo-finance2": "^2.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "glob": "^8.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup/env.js"
    ],
    "globalSetup": "./tests/setup/globalSetup.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/setup/",
      "/tests/helpers/"
    ],
    "roots": [
      "<rootDir>/tests"
    ]
  },
  "engines": {
    "node": ">=18.17"
  }
}
